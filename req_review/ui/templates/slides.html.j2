<!doctype html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ReqLens · Питч</title>
<style>
{{ tokens_css()|safe }}
{{ asset("base.css")|safe }}
html,body{height:100%;overflow:hidden}
.deck{height:100vh;position:relative;background:var(--grad-page)}
/* каждый слайд — ночная панель на градиенте рассвета (v3 «Ecliptic Dawn») */
.slide{position:absolute;inset:16px;border-radius:var(--r-panel);display:flex;flex-direction:column;justify-content:center;padding:6vh 7vw;opacity:0;pointer-events:none;overflow:auto;
  transform:translateY(12px);transition:opacity .35s var(--motion-ease),transform .35s var(--motion-ease);box-shadow:var(--shadow-xl);
  background:radial-gradient(70% 55% at 50% 118%,color-mix(in srgb,var(--glow) 70%,transparent),transparent 70%),var(--panel)}
.slide:first-child{background:#02020E var(--grad-dawn) bottom/100% 1100px no-repeat}
.slide:first-child .lead{color:#1B2052}.slide:first-child .k,.slide:first-child .logo{color:#050719}
.slide.on{opacity:1;pointer-events:auto;transform:none}
.k{font:500 clamp(36px,6vw,88px)/1.02 var(--font-sans);letter-spacing:-.045em}
.k2{font:500 clamp(30px,4.4vw,56px)/1.04 var(--font-sans);letter-spacing:-.04em}
.grad{background:linear-gradient(90deg,var(--indigo-400),var(--dawn-100));-webkit-background-clip:text;background-clip:text;color:transparent}
.slide:first-child .grad{background:none;color:#050719}
.lead{font:400 clamp(16px,1.7vw,22px)/1.5 var(--font-sans);color:var(--text-2);max-width:920px;margin-top:18px}
.big{font:500 clamp(64px,10vw,140px)/1 var(--font-sans);letter-spacing:-.05em;font-variant-numeric:tabular-nums}
.num{position:fixed;right:40px;bottom:36px;font:600 13px/1 var(--font-sans);color:var(--text-3)}
.nav{position:fixed;left:40px;bottom:32px;display:flex;gap:8px}
.cols{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}
.cols.c4{grid-template-columns:repeat(4,1fr)}
@media (max-width:900px){.cols,.cols.c4{grid-template-columns:1fr}}
.cols .card{padding:22px}.cols .card.hero{background:radial-gradient(120% 100% at 50% 130%,var(--indigo-500),var(--indigo-900) 58%,var(--indigo-950));color:#fff;border-color:color-mix(in srgb,var(--accent) 40%,transparent)}.cols .card.hero .ic,.cols .card.hero .muted{color:rgba(255,255,255,.85)}.cols .ic{color:var(--brand)}
.shot{border-radius:16px;border:1px solid var(--border);box-shadow:var(--shadow-lg);width:100%;height:auto;display:block;background:var(--surface)}
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:36px;align-items:center}
@media (max-width:900px){.split{grid-template-columns:1fr}}
.steps{margin:20px 0 0;padding:0;list-style:none;counter-reset:s}
.steps li{counter-increment:s;display:flex;gap:12px;align-items:flex-start;margin:12px 0;font:500 17px/1.45 var(--font-sans)}
.steps li::before{content:counter(s);flex:none;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--brand);color:#fff;font:700 13px/1 var(--font-sans)}
.metric-big{font:500 clamp(44px,6vw,80px)/1 var(--font-sans);letter-spacing:-.04em;color:var(--brand)}
.vs{width:100%;border-collapse:separate;border-spacing:0;font:var(--t-small);background:var(--surface);border-radius:16px;overflow:hidden;margin-top:24px}
.vs th,.vs td{padding:11px 14px;border-bottom:1px solid var(--border);text-align:left}
.vs th{font:600 12px/16px var(--font-sans);text-transform:uppercase;letter-spacing:.06em;color:var(--text-3)}
.vs td:first-child{font-weight:600}.vs tr:last-child td{border-bottom:0}
.vs .us{background:var(--brand-soft)}
.y{color:var(--ok);font-weight:700}.n{color:var(--text-3)}.p{color:var(--major);font-weight:600}
.arch svg{width:100%;height:auto;display:block}
.trust{width:100%;margin-top:12px;border-collapse:collapse;font:600 15px/1.3 var(--font-sans)}
.trust th{font:600 11px/1 var(--font-sans);text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.8);text-align:left;padding:0 0 8px}
.trust td{padding:8px 0;border-top:1px solid rgba(255,255,255,.2)}
.trust td+td,.trust th+th{text-align:right}
.trust td:nth-child(2),.trust td:nth-child(3){font:800 24px/1 var(--font-sans)}
.arch text{font-family:var(--font-sans)}
.person{display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px}
.avatar{width:84px;height:84px;border-radius:50%;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand);border:3px solid var(--brand);font:800 28px/1 var(--font-sans)}
@media print{html,body{overflow:visible;height:auto}.slide{position:relative;opacity:1;transform:none;height:100vh;page-break-after:always}.nav,.num{display:none}}
</style>
</head>
<body>
<div class="deck" id="deck">
  <!-- 1. Титул -->
  <section class="slide" aria-label="Титул">
    <div class="logo" style="font-size:22px"><span class="logo-mark" style="width:44px;height:44px">{{ logo_mark(44) }}</span>ReqLens</div>
    <h1 class="k" style="margin-top:32px">Дефекты требований —<br><span class="grad">до первой строчки кода</span></h1>
    <p class="lead">ИИ-агент статической проверки документа требований по ISO/IEC/IEEE 29148 и IEEE 830: подсветка дефектов в тексте, тест-проба, граф противоречий и исправленный документ. BCC-HUB × MNU FinTech Hackathon.</p>
  </section>

  <!-- 2. Проблема -->
  <section class="slide" aria-label="Проблема">
    <div class="caption">Проблема</div>
    <div class="big grad" style="margin:16px 0">~100×</div>
    <p class="lead">Ориентир из литературы: дефект требований, найденный в эксплуатации, обходится на порядки дороже, чем найденный на ревью. «Быстро», «удобно», «и т. д.» доходят до кода — и до инцидентов. Ручное ревью — долго, субъективно и без трассировки.</p>
    <div class="cols">
      <div class="card hero">{{ icon("alert", 26) }}<div class="h3" style="margin-top:10px">Двусмысленность</div><p class="small muted">«Система должна быстро проверять получателя» — сколько это?</p></div>
      <div class="card">{{ icon("layers", 26) }}<div class="h3" style="margin-top:10px">Противоречия</div><p class="small muted">500 000 ₸ в одном пункте и 300 000 ₸ в другом.</p></div>
      <div class="card">{{ icon("flask", 26) }}<div class="h3" style="margin-top:10px">Непроверяемость</div><p class="small muted">Тестировщик не может написать приёмочный тест.</p></div>
    </div>
  </section>

  <!-- 3. Решение -->
  <section class="slide" aria-label="Решение">
    <div class="caption">Решение</div>
    <h2 class="k2">Один запуск — полный разбор и готовые правки</h2>
    <div class="cols c4">
      <div class="card hero">{{ icon("file", 26) }}<div class="h3" style="margin-top:10px">Документ</div><p class="small muted">Дефекты подчёркнуты в тексте; карточка: критерий, объяснение, правка.</p></div>
      <div class="card">{{ icon("cube", 26) }}<div class="h3" style="margin-top:10px">3D-граф</div><p class="small muted">Противоречия, зависимости и дубликаты; цепочка конфликта.</p></div>
      <div class="card">{{ icon("flask", 26) }}<div class="h3" style="margin-top:10px">Тесты</div><p class="small muted">Gherkin к каждому требованию и tests.feature — или доказательство непроверяемости.</p></div>
      <div class="card">{{ icon("wand", 26) }}<div class="h3" style="margin-top:10px">Исправления</div><p class="small muted">Diff было → стало, вопросы аналитику, «До / После» балла.</p></div>
    </div>
    <p class="lead"><code class="mono">python review.py docs/requirements.md reports/report.md</code> · или перетащите файл в ReqLens Studio.</p>
  </section>

  <!-- 4. Архитектура -->
  <section class="slide" aria-label="Архитектура">
    <div class="caption">Архитектура</div>
    <h2 class="k2">Конвейер агента: модель предлагает — код проверяет</h2>
    <div class="arch card" style="margin-top:24px;padding:20px">
      <svg viewBox="0 0 1200 380" role="img" aria-label="Схема: вход, конвейер агента, LLM-провайдеры, проверки кодом, артефакты и интерфейсы">
        <defs><marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="#8C91B5"/></marker></defs>
        <g font-size="14" fill="#F4F5FF">
          <rect x="10" y="150" width="130" height="80" rx="14" fill="#0B0E24" stroke="#2A2F55"/><text x="75" y="184" text-anchor="middle" font-weight="700">Документ</text><text x="75" y="206" text-anchor="middle" font-size="12" fill="#A3A8C9">PDF · DOCX · MD · TXT</text>
          <rect x="180" y="40" width="760" height="300" rx="20" fill="#12163A" stroke="#8E9BFF" stroke-dasharray="6 6"/>
          <text x="200" y="68" font-size="12" font-weight="700" fill="#3B4CB6" letter-spacing="1">КОНВЕЙЕР АГЕНТА (pipeline.py)</text>
          <g>
            <rect x="200" y="90" width="120" height="56" rx="12" fill="#0B0E24" stroke="#2A2F55"/><text x="260" y="123" text-anchor="middle" font-weight="600">Чтение</text>
            <rect x="340" y="90" width="120" height="56" rx="12" fill="#0B0E24" stroke="#2A2F55"/><text x="400" y="116" text-anchor="middle" font-weight="600">Нарезка</text><text x="400" y="134" text-anchor="middle" font-size="11" fill="#A3A8C9">ID · модальные</text>
            <rect x="480" y="90" width="150" height="56" rx="12" fill="#3B4CB6"/><text x="555" y="116" text-anchor="middle" font-weight="700" fill="#0B0E24">9 критериев</text><text x="555" y="134" text-anchor="middle" font-size="11" fill="#E3E6FF">+ тест-проба Gherkin</text>
            <rect x="650" y="90" width="130" height="56" rx="12" fill="#0B0E24" stroke="#2A2F55"/><text x="715" y="116" text-anchor="middle" font-weight="600">Набор</text><text x="715" y="134" text-anchor="middle" font-size="11" fill="#A3A8C9">противоречия, дубли</text>
            <rect x="800" y="90" width="120" height="56" rx="12" fill="#0B0E24" stroke="#2A2F55"/><text x="860" y="116" text-anchor="middle" font-weight="600">Домен</text><text x="860" y="134" text-anchor="middle" font-size="11" fill="#A3A8C9">финтех, глоссарий</text>
            <path d="M320 118h18M460 118h18M630 118h18M780 118h18" stroke="#8C91B5" stroke-width="1.6" marker-end="url(#ar)"/>
            <rect x="200" y="200" width="170" height="56" rx="12" fill="#0B0E24" stroke="#2A2F55"/><text x="285" y="226" text-anchor="middle" font-weight="600">Проверка цитат</text><text x="285" y="244" text-anchor="middle" font-size="11" fill="#A3A8C9">выдуманное отбрасывается</text>
            <rect x="390" y="200" width="150" height="56" rx="12" fill="#0B0E24" stroke="#2A2F55"/><text x="465" y="226" text-anchor="middle" font-weight="600">Критик-агент</text><text x="465" y="244" text-anchor="middle" font-size="11" fill="#A3A8C9">уверенность</text>
            <rect x="560" y="200" width="150" height="56" rx="12" fill="#0B0E24" stroke="#2A2F55"/><text x="635" y="226" text-anchor="middle" font-weight="600">Баллы кодом</text><text x="635" y="244" text-anchor="middle" font-size="11" fill="#A3A8C9">формулы, без LLM</text>
            <rect x="730" y="200" width="190" height="56" rx="12" fill="#0B0E24" stroke="#2A2F55"/><text x="825" y="226" text-anchor="middle" font-weight="600">Исправления + граф</text><text x="825" y="244" text-anchor="middle" font-size="11" fill="#A3A8C9">diff, вопросы, связи</text>
            <path d="M860 146v24H285v28" fill="none" stroke="#8C91B5" stroke-width="1.6" marker-end="url(#ar)"/>
            <path d="M370 228h18M540 228h18M710 228h18" stroke="#8C91B5" stroke-width="1.6" marker-end="url(#ar)"/>
            <text x="560" y="300" text-anchor="middle" font-size="12" fill="#A3A8C9">правила-словари подсказывают модели и страхуют её ответы</text>
          </g>
          <path d="M140 190h38" stroke="#8C91B5" stroke-width="1.6" marker-end="url(#ar)"/>
          <rect x="480" y="2" width="300" height="30" rx="10" fill="#12163A" stroke="#9191D3"/><text x="630" y="22" text-anchor="middle" font-size="12" font-weight="600" fill="#C9CEFF">LLM: Gemini · OpenAI-совм. · Ollama (офлайн)</text>
          <path d="M555 32v56" stroke="#9191D3" stroke-width="1.6" stroke-dasharray="4 4" marker-end="url(#ar)"/>
          <path d="M940 190h38" stroke="#8C91B5" stroke-width="1.6" marker-end="url(#ar)"/>
          <rect x="980" y="60" width="210" height="130" rx="14" fill="#0B0E24" stroke="#2A2F55"/><text x="1000" y="86" font-weight="700">Артефакты</text>
          <text x="1000" y="110" font-size="12" fill="#A3A8C9">report.md (по ТЗ)</text><text x="1000" y="130" font-size="12" fill="#A3A8C9">report.html — офлайн, 3D</text><text x="1000" y="150" font-size="12" fill="#A3A8C9">JSON · Excel · CSV Jira</text><text x="1000" y="170" font-size="12" fill="#A3A8C9">tests.feature · fixed.md</text>
          <rect x="980" y="210" width="210" height="110" rx="14" fill="#3B4CB6"/><text x="1000" y="236" font-weight="700" fill="#0B0E24">Интерфейсы</text>
          <text x="1000" y="260" font-size="12" fill="#E3E6FF">CLI · GitHub Action</text><text x="1000" y="280" font-size="12" fill="#E3E6FF">Studio: FastAPI + SSE</text><text x="1000" y="300" font-size="12" fill="#E3E6FF">AI-ассистент · До / После</text>
        </g>
      </svg>
    </div>
  </section>

  <!-- 5. Демо -->
  <section class="slide" aria-label="Демо">
    <div class="split">
      <div><div class="caption">Демо · 90 секунд</div><h2 class="k2" style="margin-top:8px">Перетащили файл — агент работает вживую</h2>
        <ol class="steps">
          <li>Drag-and-drop в ReqLens Studio: таймлайн шагов и таблица требований заполняются по мере проверки.</li>
          <li>«Документ»: дефекты подчёркнуты, как в проверке орфографии; <span class="kbd">J</span> — следующий.</li>
          <li>«Граф»: красное ребро — противоречие; клик — цепочка конфликта.</li>
          <li>AI-ассистент: «Почему R-006 критичное?» — ответ со ссылками.</li>
          <li>«До / После»: проверка исправленной версии — балл растёт.</li>
        </ol></div>
      <img class="shot" src="assets/live-run.gif" alt="Живой прогон в ReqLens Studio: требования появляются в таблице по мере проверки">
    </div>
  </section>

  <!-- 6. Ключевые экраны -->
  <section class="slide" aria-label="Ключевые экраны">
    <div class="caption">Отчёт — один офлайн-файл HTML</div>
    <h2 class="k2">Документ · 3D-граф · До / После</h2>
    <div class="cols">
      <figure style="margin:0"><img class="shot" src="assets/screenshot-doc-dark.png" alt="Документ с подсветкой дефектов и карточкой замечания"><figcaption class="small muted" style="margin-top:8px">Подсветка в тексте, миникарта, карточка с правкой</figcaption></figure>
      <figure style="margin:0"><img class="shot" src="assets/screenshot-graph-dark.png" alt="3D-граф требований"><figcaption class="small muted" style="margin-top:8px">3D-граф: цвет — статус, размер — дефекты; 2D — запасной вид</figcaption></figure>
      <figure style="margin:0"><img class="shot" src="assets/screenshot-studio-compare.png" alt="Экран До / После"><figcaption class="small muted" style="margin-top:8px">Сравнение версий: балл, исправленные и новые дефекты</figcaption></figure>
    </div>
  </section>

  <!-- 7. Почему нам можно верить: цитата документа + основание в норме + бенчмарк с/без RAG -->
  <section class="slide" aria-label="Почему нам можно верить">
    <div class="caption">Доверие</div>
    <h2 class="k2">Почему нам можно верить</h2>
    <div class="cols">
      <div class="card"><div class="caption">1 · Аудит цитат</div>
        <p class="small" style="margin-top:10px">Каждое замечание — с дословной цитатой и номером строки. Код сверяет каждую цитату с документом; выдуманная — замечание отбрасывается. Итог аудита — первая строка отчёта.</p>
        <div class="quote small" style="margin-top:12px">«Цитат в замечаниях — N, подтверждено в документе — N, отброшено как выдуманные — M. Учтено строк документа: X из X.»</div></div>
      <div class="card"><div class="caption">2 · Основание в норме</div>
        <p class="small" style="margin-top:10px">RAG находит пункт стандарта, закон РК или шаблон и прикладывает фрагмент базы знаний с источником — «по памяти» модель не цитирует.</p>
        <div class="quote small" style="margin-top:12px">ISO/IEC/IEEE 29148 · п. 5.2.5 d) Complete — пересказ своими словами; законы РК — со ссылкой на adilet.zan.kz</div></div>
      <div class="card hero"><div class="caption" style="color:rgba(255,255,255,.85)">3 · Бенчмарк: {{ bench.recall_note }}</div>
        <table class="trust" aria-label="Бенчмарк без RAG и с RAG">
          <thead><tr><th></th><th>без RAG</th><th>с RAG</th></tr></thead>
          <tbody>
            <tr><td>Recall</td><td>{{ bench.recall }}</td><td>{{ bench_rag.recall }}</td></tr>
            <tr><td>Precision</td><td>{{ bench.precision }}</td><td>{{ bench_rag.precision }}</td></tr>
            <tr><td>F1</td><td>{{ bench.f1 }}</td><td>{{ bench_rag.f1 }}</td></tr>
          </tbody></table>
        <p class="small muted" style="margin-top:10px">{{ bench.model_note }}{% if bench_rag.recall == "—" %} Колонка «с RAG» — после прогона <code class="mono">bench/run.py</code> с базой знаний.{% else %} С RAG: {{ bench_rag.model_note }}{% endif %}</p></div>
    </div>
    <p class="lead small">Только измеренные цифры: <code class="mono">bench/RESULTS.md</code>{% if bench_rag.recall != "—" %} и <code class="mono">bench/RESULTS_RAG.md</code>{% endif %}, модель и дата прогона указаны в файле. Баллы считает код по формулам из «Методики оценки».</p>
  </section>

  <!-- 7b. Устойчивость: без модели, незнакомый документ, исправил → проверил заново -->
  <section class="slide" aria-label="Устойчивость">
    <div class="caption">Устойчивость</div>
    <h2 class="k2">Работает, даже когда модель недоступна</h2>
    <div class="cols">
      <div class="card"><div class="caption">Без модели</div>
        <p class="small" style="margin-top:10px">Квота закончилась или нет сети — <code class="mono">LLM_PROVIDER=rules</code>: детерминированные правила находят размытые формулировки, плейсхолдеры, числовые конфликты, ошибки API, отсутствие метода чтения и контракта событий. В паспорте это честно указано.</p></div>
      <div class="card"><div class="caption">Незнакомый документ</div>
        <p class="small" style="margin-top:10px">В бенчмарке есть документ с формулировками дефектов, которых агент не видел при разработке, — проверка, что правила общие, а не подогнаны под один текст.</p></div>
      <div class="card"><div class="caption">Исправил → проверил заново</div>
        <p class="small" style="margin-top:10px"><code class="mono">--fix-loop</code>: агент переписывает формулировки, проверяет исправленный документ и показывает «До / После» — балл, готовность, критичные и что осталось решить аналитику.</p></div>
    </div>
    <p class="lead small">Повторить прогон может любой: Actions → <b>Generate report</b> со своим ключом — отчёт в md, html, json и pdf.</p>
  </section>

  <!-- 8. Отличие от конкурентов -->
  <section class="slide" aria-label="Отличие от конкурентов">
    <div class="caption">Чем отличаемся</div>
    <h2 class="k2">Не «ещё один чат-бот», а проверяемый агент</h2>
    <table class="vs">
      <thead><tr><th>Возможность</th><th class="us">ReqLens</th><th>Ручное ревью</th><th>Общий LLM-чат</th><th>Классические анализаторы требований</th></tr></thead>
      <tbody>
        <tr><td>Критерии ISO/IEC/IEEE 29148 с пунктами стандарта</td><td class="us y">✓ да</td><td class="p">~ зависит от ревьюера</td><td class="p">~ без гарантий</td><td class="y">✓ да</td></tr>
        <tr><td>Дословная цитата, проверенная кодом</td><td class="us y">✓ да</td><td class="y">✓ да</td><td class="n">— нет (галлюцинации)</td><td class="y">✓ да</td></tr>
        <tr><td>Тест-проба Gherkin как доказательство</td><td class="us y">✓ да</td><td class="n">— нет</td><td class="p">~ по запросу</td><td class="n">— нет</td></tr>
        <tr><td>Противоречия и дубли во всём наборе</td><td class="us y">✓ граф</td><td class="p">~ долго</td><td class="p">~ в пределах окна</td><td class="p">~ частично</td></tr>
        <tr><td>Русский язык и финтех-чек-лист</td><td class="us y">✓ да</td><td class="y">✓ да</td><td class="p">~ без чек-листа</td><td class="n">— в основном английский</td></tr>
        <tr><td>Офлайн: документ не покидает контур</td><td class="us y">✓ Ollama</td><td class="y">✓ да</td><td class="n">— облако</td><td class="p">~ лицензия on-prem</td></tr>
        <tr><td>Исправленный документ и «До / После»</td><td class="us y">✓ да</td><td class="n">— нет</td><td class="p">~ вручную</td><td class="n">— нет</td></tr>
      </tbody>
    </table>
  </section>

  <!-- 9. Команда (показывается, только если docs/team.yaml заполнен) -->
  {% if team %}
  <section class="slide" aria-label="Команда">
    <div class="caption">Команда</div>
    <h2 class="k2">Кто делал ReqLens</h2>
    <div class="cols c4">
      {% for m in team %}<div class="card person"><span class="avatar" aria-hidden="true">{{ m.initials }}</span><div class="h3">{{ m.name }}</div><p class="small muted">{{ m.role }}</p></div>{% endfor %}
    </div>
    <p class="lead small">Состав команды задаётся в <code class="mono">docs/team.yaml</code> — слайды собираются командой <code class="mono">python -m req_review.ui.styleguide</code>.</p>
  </section>
  {% endif %}

  <!-- 10. Финал -->
  <section class="slide" aria-label="Спасибо">
    <div class="logo" style="font-size:22px"><span class="logo-mark" style="width:44px;height:44px">{{ logo_mark(44) }}</span>ReqLens</div>
    <h2 class="k" style="margin-top:28px">Спасибо!<br><span class="grad">Вопросы?</span></h2>
    <p class="lead">Дальше: интеграция с Confluence и Jira, ревью требований в каждом PR, новые доменные чек-листы одним YAML-файлом.</p>
  </section>
</div>
<div class="nav"><button class="btn btn-secondary btn-sm" id="prev" aria-label="Назад">←</button><button class="btn btn-secondary btn-sm" id="next" aria-label="Вперёд">→</button></div>
<div class="num" id="num" aria-live="polite"></div>
<script>
(function(){const s=[...document.querySelectorAll(".slide")];let i=Math.max(0,Math.min(s.length-1,(+location.hash.slice(1)||1)-1));
const go=n=>{i=Math.max(0,Math.min(s.length-1,n));s.forEach((x,k)=>{x.classList.toggle("on",k===i);x.setAttribute("aria-hidden",k!==i);});document.getElementById("num").textContent=`${i+1} / ${s.length}`;history.replaceState(null,"","#"+(i+1));};
document.addEventListener("keydown",e=>{if(["ArrowRight","PageDown"," "].includes(e.key))go(i+1);else if(["ArrowLeft","PageUp"].includes(e.key))go(i-1);else if(e.key==="p"||e.key==="P")print();});
document.getElementById("next").onclick=()=>go(i+1);document.getElementById("prev").onclick=()=>go(i-1);go(i);})();
</script>
</body>
</html>
