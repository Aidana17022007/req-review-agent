<!doctype html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ReqLens · Питч</title>
<style>
{{ tokens_css()|safe }}
{{ asset("base.css")|safe }}
html,body{height:100%;overflow:hidden}
.deck{height:100vh;position:relative}
.slide{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:6vh 8vw;opacity:0;pointer-events:none;
  transform:translateY(12px);transition:opacity .35s var(--motion-ease),transform .35s var(--motion-ease);
  background:radial-gradient(900px 400px at 0% 0%,color-mix(in srgb,var(--brand) 16%,transparent),transparent 60%),
             radial-gradient(700px 300px at 100% 100%,color-mix(in srgb,#8B5CF6 12%,transparent),transparent 60%),var(--bg)}
.slide.on{opacity:1;pointer-events:auto;transform:none}
.k{font:800 clamp(36px,6vw,76px)/1.05 var(--font-sans);letter-spacing:-.035em}
.grad{background:linear-gradient(90deg,var(--brand),#A78BFA);-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{font:400 clamp(16px,1.8vw,24px)/1.5 var(--font-sans);color:var(--text-2);max-width:900px;margin-top:20px}
.big{font:800 clamp(64px,10vw,140px)/1 var(--font-sans);letter-spacing:-.04em}
.num{position:fixed;right:24px;bottom:20px;font:600 13px/1 var(--font-sans);color:var(--text-3)}
.nav{position:fixed;left:24px;bottom:16px;display:flex;gap:8px}
.cols{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px}
@media (max-width:800px){.cols{grid-template-columns:1fr}}
.cols .card{padding:22px}.cols .ic{color:var(--brand)}
.flow{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:32px}
.flow span{padding:10px 14px;border-radius:12px;background:var(--surface);border:1px solid var(--border);font:600 15px/1 var(--font-sans)}
.flow i{color:var(--text-3);font-style:normal}
@media print{html,body{overflow:visible;height:auto}.slide{position:relative;opacity:1;transform:none;height:100vh;page-break-after:always}.nav,.num{display:none}}
</style>
</head>
<body>
<div class="deck" id="deck">
  <section class="slide">
    <div class="logo" style="font-size:22px"><span class="logo-mark" style="width:44px;height:44px;border-radius:13px">{{ icon("lens", 24) }}</span>ReqLens</div>
    <h1 class="k" style="margin-top:32px">Дефекты требований —<br><span class="grad">до первой строчки кода</span></h1>
    <p class="lead">ИИ-агент статической проверки документа требований по ISO/IEC/IEEE 29148 и IEEE 830. BCC-HUB × MNU FinTech Hackathon.</p>
  </section>
  <section class="slide">
    <div class="caption">Проблема</div>
    <div class="big grad" style="margin:16px 0">~100×</div>
    <p class="lead">Ориентир из литературы: дефект требований, найденный в эксплуатации, обходится на порядки дороже, чем найденный на ревью. «Быстро», «удобно», «и т. д.» доходят до кода — и до инцидентов.</p>
  </section>
  <section class="slide">
    <div class="caption">Как работает</div>
    <h2 class="k" style="font-size:clamp(32px,4.5vw,56px)">Один запуск — полный разбор</h2>
    <div class="flow"><span>PDF · DOCX · MD</span><i>→</i><span>Нарезка</span><i>→</i><span>9 критериев 29148</span><i>→</i><span>Тест-проба</span><i>→</i><span>Набор целиком</span><i>→</i><span>Критик</span><i>→</i><span>Проверка цитат</span><i>→</i><span>Отчёт</span></div>
    <p class="lead"><code class="mono">python review.py docs/requirements.md reports/report.md</code></p>
  </section>
  <section class="slide">
    <div class="caption">Вау</div>
    <h2 class="k" style="font-size:clamp(32px,4.5vw,56px)">Grammarly для требований</h2>
    <div class="cols">
      <div class="card">{{ icon("file", 26) }}<div class="h3" style="margin-top:10px">Подсветка в тексте</div><p class="small muted">Клик по дефекту — пункт стандарта, проблема и готовая формулировка.</p></div>
      <div class="card">{{ icon("flask", 26) }}<div class="h3" style="margin-top:10px">Тест-проба</div><p class="small muted">Агент пишет Given/When/Then. Не получилось — доказательство непроверяемости.</p></div>
      <div class="card">{{ icon("wand", 26) }}<div class="h3" style="margin-top:10px">Было → стало</div><p class="small muted">Исправленный документ и повторная оценка: балл до и после.</p></div>
    </div>
  </section>
  <section class="slide">
    <div class="caption">Доверие</div>
    <h2 class="k" style="font-size:clamp(32px,4.5vw,56px)">Никаких галлюцинаций в отчёте</h2>
    <div class="cols">
      <div class="card">{{ icon("check", 26) }}<div class="h3" style="margin-top:10px">Цитаты проверяет код</div><p class="small muted">Замечание без дословной цитаты отбрасывается.</p></div>
      <div class="card">{{ icon("shield", 26) }}<div class="h3" style="margin-top:10px">Критик-агент</div><p class="small muted">Второй проход: подтвердить, понизить, отклонить — с уверенностью.</p></div>
      <div class="card">{{ icon("spark", 26) }}<div class="h3" style="margin-top:10px">Бенчмарк</div><p class="small muted">13 известных дефектов → recall и precision из bench/RESULTS.md.</p></div>
    </div>
  </section>
  <section class="slide">
    <div class="caption">Для банка</div>
    <h2 class="k" style="font-size:clamp(32px,4.5vw,56px)">Финтех-экспертиза и офлайн</h2>
    <div class="cols">
      <div class="card">{{ icon("bank", 26) }}<div class="h3" style="margin-top:10px">Чек-лист полноты</div><p class="small muted">2FA, лимиты, идемпотентность, AML, персональные данные, SLA, RTO/RPO.</p></div>
      <div class="card">{{ icon("shield", 26) }}<div class="h3" style="margin-top:10px">Документ не покидает контур</div><p class="small muted">Профиль offline — локальная модель через Ollama.</p></div>
      <div class="card">{{ icon("download", 26) }}<div class="h3" style="margin-top:10px">Сразу в работу</div><p class="small muted">Excel-трассировка, CSV для Jira, вопросы заказчику.</p></div>
    </div>
  </section>
  <section class="slide">
    <div class="caption">Соответствие ТЗ</div>
    <h2 class="k" style="font-size:clamp(32px,4.5vw,56px)">Всё, что требуется — и больше</h2>
    <p class="lead">Одна команда · PDF/DOCX/MD/TXT · отчёт на русском в файл · паспорт с моделью и коммитом · нарезка с ID · проверка каждого требования и набора · сводка и итог · ссылки на строки и цитаты · README и .env.example.</p>
  </section>
  <section class="slide">
    <div class="logo" style="font-size:22px"><span class="logo-mark" style="width:44px;height:44px;border-radius:13px">{{ icon("lens", 24) }}</span>ReqLens</div>
    <h2 class="k" style="margin-top:28px">Спасибо!<br><span class="grad">Вопросы?</span></h2>
    <p class="lead">Дальше: интеграция с Confluence и Jira, ревью требований в каждом PR, новые доменные чек-листы одним YAML-файлом.</p>
  </section>
</div>
<div class="nav"><button class="btn btn-secondary btn-sm" id="prev" aria-label="Назад">←</button><button class="btn btn-secondary btn-sm" id="next" aria-label="Вперёд">→</button></div>
<div class="num" id="num"></div>
<script>
(function(){const s=[...document.querySelectorAll(".slide")];let i=Math.max(0,Math.min(s.length-1,(+location.hash.slice(1)||1)-1));
const go=n=>{i=Math.max(0,Math.min(s.length-1,n));s.forEach((x,k)=>x.classList.toggle("on",k===i));document.getElementById("num").textContent=`${i+1} / ${s.length}`;history.replaceState(null,"","#"+(i+1));};
document.addEventListener("keydown",e=>{if(["ArrowRight","PageDown"," "].includes(e.key))go(i+1);else if(["ArrowLeft","PageUp"].includes(e.key))go(i-1);else if(e.key==="p"||e.key==="P")print();});
document.getElementById("next").onclick=()=>go(i+1);document.getElementById("prev").onclick=()=>go(i-1);go(i);})();
</script>
</body>
</html>
