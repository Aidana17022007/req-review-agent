<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="generator" content="ReqLens">
<title>ReqLens · {{ title }}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='13' fill='%23E7F4EC' stroke='%231F6B45' stroke-width='4'/%3E%3Ccircle cx='16' cy='16' r='4.5' fill='%231F6B45'/%3E%3C/svg%3E">
<style>
{{ tokens_css()|safe }}
{{ asset("base.css")|safe }}
</style>
<script>(function(){try{var t=localStorage.getItem("reqlens-theme");if(t)document.documentElement.dataset.theme=t}catch(e){}})()</script>
</head>
<body>
<a class="sr-only" href="#main">Перейти к содержимому</a>
<div class="app">
  <aside class="sidebar" id="sidebar" aria-label="Навигация">
    <div class="logo"><span class="logo-mark">{{ icon("lens", 18) }}</span><span>ReqLens<small>ревью требований</small></span></div>
    <div class="nav-label">Меню</div>
    <nav id="nav" aria-label="Разделы отчёта"></nav>
    <div class="nav-label">Общее</div>
    <button class="nav-item" id="btn-theme" type="button">{{ icon("moon") }}<span>Тёмная тема</span></button>
    <button class="nav-item" id="btn-keys" type="button">{{ icon("keyboard") }}<span>Горячие клавиши</span></button>
    <button class="nav-item" id="btn-print" type="button">{{ icon("print") }}<span>Печать / PDF</span></button>
    <div class="promo no-print" style="margin-top:auto">
      <div class="h3">ReqLens Studio</div>
      <p>Проверяйте документы в браузере: перетащите файл — агент сделает остальное.</p>
      <code>python -m req_review.web</code>
    </div>
  </aside>

  <div class="main" id="main">
    <div class="topbar">
      <button class="btn btn-round burger" id="burger" aria-label="Открыть меню" aria-controls="sidebar">{{ icon("menu") }}</button>
      <label class="search"><span class="sr-only">Поиск по требованиям</span>{{ icon("search", 17) }}
        <input id="gsearch" type="search" placeholder="Поиск по требованиям, цитатам, ID…"><span class="kbd hide-sm">/</span></label>
      <span class="grow"></span>
      <span class="chip chip-brand hide-sm" id="top-model"></span>
    </div>
    <div class="content">
      <h1 class="print-title h1">Отчёт о проверке требований: {{ title }}</h1>
      {% if mock %}<div class="banner-mock">⚠️ Тестовый прогон (LLM_PROVIDER=mock): модель не вызывалась, замечания сгенерированы эвристиками. Отчёт не подходит для сдачи.</div>{% endif %}
      <header class="pagehead" id="pagehead"></header>
      <div id="views"></div>
      <footer class="footer" id="footer"></footer>
    </div>
  </div>
</div>

<div class="overlay" id="overlay"></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true">
  <header><div class="grow h2" id="drawer-title">Замечание</div>
    <button class="btn btn-round" id="drawer-close" aria-label="Закрыть">{{ icon("x") }}</button></header>
  <div class="body" id="drawer-body"></div>
</aside>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script type="application/json" id="data">{{ data_json|safe }}</script>
<script>const ICONS = {{ ICONS|tojson }};</script>
<script>
{{ asset("report.js")|safe }}
</script>
</body>
</html>
