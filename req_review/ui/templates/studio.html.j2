    [/^шаг (\d+) из (\d+)$/,"$2 қадамның $1-і"],[/^проверено (\d+) из (\d+)$/,"$2 ішінен $1 тексерілді"],[/^версий: (\d+)$/,"нұсқалар: $1"],
    [/^черновик сохранён · (\d\d:\d\d)$/,"черновик сақталды · $1"],
    [/^Можно снова через (?:(\d+) ч )?(\d+) мин — около (.+)\.$/,(m,h,mi,at)=>`Қайта ${h?h+" сағ ":""}${mi} мин кейін — шамамен ${at}.`],
    [/^(.+) — балл (\d+)\/100, готовность (\d+)%$/,"$1 — балл $2/100, дайындық $3%"],
    [/^Перепроверка с ответами аналитика · учтено ответов: (\d+)$/,"Аналитик жауаптарымен қайта тексеру · ескерілген жауаптар: $1"],
    [/^Ответ на (Q-\d+)$/,"$1 сұрағына жауап"],[/^Нет таких вопросов: (.+) — эти ответы не учтены$/,"Мұндай сұрақтар жоқ: $1 — бұл жауаптар ескерілмеді"],
  ];
  const SKIP="script,style,pre,code,textarea,.msg,.pj-name,#pj-name,#p-name,#c-sub,.def-list,.tbl td.small,option";
  function tr(s){const t=s.trim();if(!t)return s;let r=KK[t];
    if(r==null)for(const [re,rep] of KK_RE)if(re.test(t)){r=t.replace(re,rep);break;}
    return r==null?s:s.replace(t,r);}
  const ATTRS=["placeholder","aria-label","title"];
  function attrs(n){for(const a of ATTRS)if(n.hasAttribute(a))n.setAttribute(a,tr(n.getAttribute(a)));}
  function translate(root){
    if(root.nodeType===3){if(!(root.parentElement&&root.parentElement.closest(SKIP)))root.nodeValue=tr(root.nodeValue);return;}
    if(root.nodeType!==1)return;attrs(root);if(root.closest(SKIP))return;
    const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT|NodeFilter.SHOW_ELEMENT);
    for(let n=w.nextNode();n;n=w.nextNode()){
      if(n.nodeType===1){attrs(n);continue;}
      if(!(n.parentElement&&n.parentElement.closest(SKIP)))n.nodeValue=tr(n.nodeValue);}}
  translate(document.body);
  new MutationObserver(ms=>ms.forEach(m=>{if(m.type==="characterData")return;m.addedNodes.forEach(translate);})).observe(document.body,{childList:true,subtree:true});
})();
