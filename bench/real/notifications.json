{
  "document": "bench/real/notifications.md",
  "title": "Уведомление о расходах по карте (документ организаторов хакатона)",
  "note": "Список ожидаемых дефектов составлен командой ReqLens своими словами по документу организаторов. Совпадение ищется по тексту проблемы и рекомендации замечания (не по цитате), поэтому это оценка «найдена ли проблема», а не дословное сравнение.",
  "defects": [
    {
      "id": "N01",
      "severity": "critical",
      "title": "GET используется для сохранения настроек",
      "match": [
        "\\bget\\b[^.]{0,160}(сохран|измен|меня)",
        "(сохранени|изменени)[^.]{0,160}\\bget\\b"
      ]
    },
    {
      "id": "N02",
      "severity": "critical",
      "title": "Ответ 200 содержит ERROR, хотя для ошибок описан 400",
      "match": [
        "error[^.]{0,200}\\b200\\b",
        "\\b200\\b[^.]{0,200}error"
      ]
    },
    {
      "id": "N03",
      "severity": "critical",
      "title": "Не указан URL для Prod",
      "match": [
        "prod"
      ]
    },
    {
      "id": "N04",
      "severity": "major",
      "title": "Content-Type указан, а тело запроса не используется",
      "match": [
        "content-type",
        "тел[оа] (запроса )?не используется"
      ]
    },
    {
      "id": "N05",
      "severity": "critical",
      "title": "Критерий приёмки о покупке 31 января противоречит Ф-2",
      "match": [
        "31 январ",
        "границ\\w* месяц",
        "феврал"
      ]
    },
    {
      "id": "N06",
      "severity": "critical",
      "title": "Ф-3 (один push в месяц) противоречит Ф-4 (push после смены порога)",
      "match": [
        "ф-3[^\\n]{0,300}ф-4",
        "ф-4[^\\n]{0,300}ф-3",
        "один[^.]{0,40}push[^.]{0,200}(смен|изменени)\\w* порог",
        "одн\\w* push[\\s\\S]{0,300}(смен|изменени)\\w* порог"
      ]
    },
    {
      "id": "N07",
      "severity": "major",
      "title": "Типы amount и enabled в запросе и ответе различаются",
      "match": [
        "(amount|enabled)[^.]{0,200}(integer|string|формат|тип)"
      ]
    },
    {
      "id": "N08",
      "severity": "major",
      "title": "Раздел 403 говорит, что возвращается 404",
      "match": [
        "403[^.]{0,200}404",
        "404[^.]{0,200}403"
      ]
    },
    {
      "id": "N09",
      "severity": "major",
      "title": "Сумма покупки в тиынах, порог — в тенге (смешение единиц)",
      "match": [
        "тиын"
      ]
    },
    {
      "id": "N10",
      "severity": "major",
      "title": "Код 201 упомянут, но не описан в статусах",
      "match": [
        "\\b201\\b"
      ]
    },
    {
      "id": "N11",
      "severity": "major",
      "title": "Раздел тестирования не заполнен («заполняются тестировщиками»)",
      "match": [
        "тестировщик",
        "не заполнен",
        "незаполненн",
        "\btbd\b"
      ]
    },
    {
      "id": "N12",
      "severity": "major",
      "title": "У требований нет приоритетов",
      "match": [
        "приоритет"
      ]
    },
    {
      "id": "N13",
      "severity": "major",
      "title": "Не задан часовой пояс / время на стыке месяцев",
      "match": [
        "часов\\w* пояс",
        "\\butc\\b",
        "алмат\\w*[^.]{0,80}(врем|пояс)"
      ]
    },
    {
      "id": "N14",
      "severity": "critical",
      "title": "В API нет метода чтения настроек и суммы за месяц",
      "match": [
        "метод\\w* чтени",
        "нет метода (для )?(чтени|получени)",
        "(чтени|получени)\\w* (настро|порог|суммы за месяц)[^.]{0,80}(не описан|отсутств|нет)"
      ]
    },
    {
      "id": "N15",
      "severity": "critical",
      "title": "Не описан контракт события процессинга",
      "match": [
        "контракт\\w* (интеграц\\w* |событ)",
        "состав\\w* (полей )?событ",
        "(формат|структур|схем)\\w* событ"
      ]
    },
    {
      "id": "N16",
      "severity": "major",
      "title": "Назначение метода противоречиво: сохранение и чтение",
      "match": [
        "назначени\\w* метода",
        "сохранени\\w*[^.]{0,60}чтени"
      ]
    },
    {
      "id": "N17",
      "severity": "major",
      "title": "Не описаны граничные случаи возвратов",
      "match": [
        "возврат\\w*[^.]{0,200}(граничн|частичн|друг\\w* месяц|предыдущ|не описан|не определ|не указан)"
      ]
    },
    {
      "id": "N18",
      "severity": "major",
      "title": "Не заданы дедупликация, порядок и опоздавшие события",
      "match": [
        "(дубл|идемпотент|дедуплик|порядок|опозда)[^.]{0,100}событ",
        "событ\\w*[^.]{0,100}(дубл|идемпотент|дедуплик|порядок|опозда)"
      ]
    },
    {
      "id": "N19",
      "severity": "major",
      "title": "Не определены токен/сессия и реакция на невалидную сессию",
      "match": [
        "(токен|сесси)\\w*[^.]{0,120}(не определ|не описан|не указан|не задан|тип)"
      ]
    },
    {
      "id": "N20",
      "severity": "major",
      "title": "После 500 неизвестно, сохранена ли настройка",
      "match": [
        "\\b500\\b[^.]{0,160}(сохран|состояни|откат)"
      ]
    },
    {
      "id": "N21",
      "severity": "major",
      "title": "Не определено первое сохранение / значение по умолчанию порога",
      "match": [
        "(не задавал|первое сохранени|первичн\\w* настро)",
        "по умолчанию[^.]{0,100}(порог|amount|значени)"
      ]
    },
    {
      "id": "N22",
      "severity": "major",
      "title": "Нет текстов сообщений об ошибках для UI",
      "match": [
        "текст\\w* (сообщени|ошибк)",
        "каталог\\w* сообщени",
        "сообщени\\w* об ошибк[^.]{0,80}(не определ|не задан|не описан|не указан)"
      ]
    },
    {
      "id": "N23",
      "severity": "major",
      "title": "Критерии приёмки покрывают малую часть правил / без предусловий",
      "match": [
        "критери\\w* при[её]мк\\w*[^.]{0,200}(покрыва|предуслови|без пример|не заданы)"
      ]
    },
    {
      "id": "N24",
      "severity": "major",
      "title": "Не определены «активная карта» и «карта KZT»",
      "match": [
        "(активн\\w* карт|карт\\w* kzt)[^.]{0,150}(не определ|не задан|не указан|критери|статус)"
      ]
    },
    {
      "id": "N25",
      "severity": "major",
      "title": "НФТ без перцентиля, нагрузки и точки измерения",
      "match": [
        "перцентил",
        "(нагрузк|точк\\w* измерени)[^.]{0,120}(не указан|не задан|нет|отсутств)"
      ]
    },
    {
      "id": "N26",
      "severity": "minor",
      "title": "Служебные разделы шаблона не заполнены (версия, чек-лист, согласующие)",
      "match": [
        "согласующ",
        "верси\\w* документ",
        "чек-лист\\w*[^.]{0,80}(не заполн|не проставл|шаблон)"
      ]
    }
  ]
}