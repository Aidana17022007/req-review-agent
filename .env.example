# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает.

# Провайдер LLM: gemini (по умолчанию) | openai (любой OpenAI-совместимый API) | mock (офлайн-заглушка для тестов)
LLM_PROVIDER=gemini

# Ключ Google AI Studio: https://aistudio.google.com/apikey (бесплатный тариф)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Для OpenAI-совместимого API (Groq, OpenRouter, локальная Ollama и т.п.)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Настройки под лимиты бесплатного тарифа
LLM_BATCH_SIZE=20         # требований в одном запросе (меньше запросов — меньше расход квоты)
LLM_MIN_INTERVAL=6        # секунд между запросами (≈10 запросов в минуту)
LLM_MAX_RETRIES=6         # повторы при 429/5xx
LLM_TEMPERATURE=0

# Кэш ответов модели (.cache/llm): повторный прогон того же документа не тратит квоту. 0 — выключить
LLM_CACHE=1

# ReqLens: профиль по умолчанию (fast | full | offline) и доменный чек-лист (fintech | none)
REQLENS_PROFILE=fast
REQLENS_DOMAIN=fintech

# Профиль offline: локальная модель через Ollama (документ не покидает компьютер)
# OFFLINE_MODEL=qwen2.5:14b
# OPENAI_BASE_URL=http://localhost:11434/v1

# ReqLens Studio (веб-интерфейс)
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000
