# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает.

# Провайдер LLM: gemini (по умолчанию) | openai (любой OpenAI-совместимый API) | rules (без модели, только правила) | mock (офлайн-заглушка для тестов)
LLM_PROVIDER=gemini

# Ключ Google AI Studio: https://aistudio.google.com/apikey (бесплатный тариф)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# При HTTP 503 («high demand») агент сам переключается на резервные модели по порядку (записывается в паспорт отчёта).
# На gemini-3.5-flash-lite получены цифры бенчмарка в bench/RESULTS.md.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Для OpenAI-совместимого API (Groq, OpenRouter, локальная Ollama и т.п.)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Настройки под лимиты бесплатного тарифа
LLM_BATCH_SIZE=20         # требований в одном запросе (меньше запросов — меньше расход квоты)
LLM_MIN_INTERVAL=6        # секунд между запросами (≈10 запросов в минуту)
# LLM_RPM=8             # лимит запросов в минуту (альтернатива LLM_MIN_INTERVAL)
LLM_MAX_RETRIES=6         # повторы при 429/5xx
LLM_TEMPERATURE=0

# Кэш ответов модели (.cache/llm): повторный прогон того же документа не тратит квоту. 0 — выключить
LLM_CACHE=1

# ReqLens: профиль по умолчанию (fast | full | offline) и доменный чек-лист (fintech | none)
REQLENS_PROFILE=fast
REQLENS_DOMAIN=fintech

# Профиль offline: локальная модель через Ollama (документ не покидает компьютер)
# OFFLINE_MODEL=qwen2.5:14b
# OPENAI_BASE_URL=http://localhost:11434/v1

# ReqLens Studio (веб-интерфейс)
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000

# RAG: база знаний kb/ (основания замечаний) и выборка контекста для длинных документов. RAG=off — выключить всё
RAG=on
# Эмбеддинги: gemini (по умолчанию при ключе) | mock | none (только BM25, без сети)
# RAG_EMBED=gemini
RAG_EMBED_MODEL=gemini-embedding-001
# Длинные документы: auto — выборка контекста, если документ длиннее порога; off — всегда полный текст
RAG_CONTEXT=auto
RAG_CONTEXT_THRESHOLD=15000
# Официальная JSON-схема ответа Gemini (responseSchema); 0 — обычный JSON-режим
GEMINI_RESPONSE_SCHEMA=1

# ReqLens App: папка истории проверок (SQLite + отчёты) и число одновременных прогонов
# REQLENS_DATA=data
# MAX_JOBS=2
